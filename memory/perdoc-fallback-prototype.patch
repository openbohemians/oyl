+/* Copy src's whole state into dst (both over the same input): a checkpoint
+ * the parser can rewind to. Keeps dst's own stack buffers. */
+bool oyl_scanner_copy(oyl_scanner *dst, const oyl_scanner *src) {
+    indent_stack ind = dst->indents;
+    void *flows = dst->flows; int flows_cap = dst->flows_cap;
+    if (ind.cap < src->indents.len) {
+        int *d = realloc(ind.data, (size_t)src->indents.cap * sizeof *d);
+        if (!d) return false;
+        ind.data = d; ind.cap = src->indents.cap;
+    }
+    if (flows_cap < src->flows_len) {
+        void *f = realloc(flows, (size_t)src->flows_cap * sizeof *src->flows);
+        if (!f) return false;
+        flows = f; flows_cap = src->flows_cap;
+    }
+    *dst = *src;
+    dst->indents.data = ind.data; dst->indents.cap = ind.cap;
+    if (src->indents.len) memcpy(ind.data, src->indents.data, (size_t)src->indents.len * sizeof *ind.data);
+    dst->flows = flows; dst->flows_cap = flows_cap;
+    if (src->flows_len) memcpy(flows, src->flows, (size_t)src->flows_len * sizeof *src->flows);
+    return true;
+}
